# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# บัญชีผู้ดูแลสำหรับเข้าสู่ระบบแก้ไขข้อมูล
ADMIN_USERNAME=admin
# สร้างด้วย: node scripts/hash-password.mjs "รหัสผ่าน"
ADMIN_PASSWORD_HASH=pbkdf2$100000$NpNQzOUEk+EXDnsxXiwRlA==$Z1OD3apE0UpP0ynaFPhm8Xhf23uy0KTAltK0qfK7c08=
# ค่าสุ่มสำหรับเซ็น session cookie (อย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=
